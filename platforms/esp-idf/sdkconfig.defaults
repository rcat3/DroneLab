# Settings shared by all ESP-IDF boards. Board specific ones are in
# boards/<board>/sdkconfig.defaults.

# 1 ms ticks, so the main loop's short delays actually yield
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Use config/lv_conf.h instead of LVGL's menuconfig options
# CONFIG_LV_CONF_SKIP is not set

# Lets LVGL's component pull in libjpeg-turbo (enabled in config/lv_conf.h)
CONFIG_LV_USE_LIBJPEG_TURBO=y

# After an update over WiFi, go back to the old firmware if the new one
# doesn't get as far as confirming it works (see core/app/updater.h)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
